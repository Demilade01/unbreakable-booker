PORT=3000

# Cal.com
CALCOM_BASE_URL=https://api.cal.com/v2
CALCOM_API_KEY=your-calcom-api-key-here

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_FROM_NUMBER=+10000000000

# Vapi.ai (optional)
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret-here
# Required when Server URL is set at org/phone level (assistant-request handling)
VAPI_ASSISTANT_ID=your-vapi-assistant-id-here